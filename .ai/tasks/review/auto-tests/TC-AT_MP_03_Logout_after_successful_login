import { test, expect } from '@fixtures/base.fixture';
import { loginAsStandardUser } from '@flows/login.flow';
import { InventoryPage } from '@pages/inventory.page';
import { AppMenu } from '@pages/components/app-menu.component';
import { LoginPage } from '@pages/login.page';

// Tags: @regression @critical @smoke
test.describe('@regression @critical @smoke MP-03 - Logout after successful login', () => {
  test('MP-03 - Logout after successful login', async ({ page }) => {
    // Arrange
    const inventoryPage = new InventoryPage(page);
    const appMenu = new AppMenu(page);
    const loginPage = new LoginPage(page);

    // Act
    // Use existing flow to perform a successful login with standard_user
    await loginAsStandardUser(page);

    // Assert - landed on inventory page after login
    await expect(page).toHaveURL(/.*inventory.html/);

    // Act - open app menu and logout
    await appMenu.open();
    await appMenu.logout();

    // Assert - after logout user is not on inventory page and is on login
    await expect(page).not.toHaveURL(/.*inventory.html/);
    await expect(loginPage.isVisible()).resolves.toBeTruthy();

    // Act - attempt direct navigation to /inventory.html after logout
    await page.goto('/inventory.html');

    // Assert - direct navigation should not allow access to inventory
    await expect(page).not.toHaveURL(/.*inventory.html/);
    await expect(loginPage.isVisible()).resolves.toBeTruthy();
  });
});
